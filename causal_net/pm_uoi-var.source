#!/bin/bash
#  salloc -q interactive -C cpu -t 4:00:00 -A nstaff 

IMG=balewski/casual-net:p1m  # no MPI
#IMG=balewski/casual-net:p1n  # with MPI, not loading python modules

CFSH=/global/cfs/cdirs/mpccc/balewski/

echo launch image $IMG
echo you are launching Podman-HPC image ...  remeber to exit

JNB_PORT=' '
BASE_DIR=/2025_UoI-VAR   # here git has home
WORK_DIR=$BASE_DIR/causal_network_inference/
DATA_VAULT=${CFSH}/bioDataVault2025
DATA_DIR=/data_tmp

echo "The number of arguments is: $#"
#  encoded variables:    jnb
for var in "$@"; do
  echo "The length of argument '$var' is: ${#var}"
  if [[ "jnb" ==  $var ]];  then
     JNB_PORT="    -p 8833:8833 "
     echo added  $JNB_PORT
     echo "  cd notebooks;  jupyter notebook --ip 0.0.0.0 --no-browser --allow-root --port  8833 "
  fi
  # ... more ...
done

podman-hpc run -it \
   --volume $CFSH/$BASE_DIR:$BASE_DIR \
   --volume $CFSH/$WORK_DIR:$WORK_DIR \
   --volume ${DATA_VAULT}:/dataVault \
   --volume ${DATA_VAULT}/$DATA_DIR:/data_tmp \
   -e DISPLAY  --net=host -v $HOME:$HOME -e HOME  \
   --workdir $WORK_DIR \
   $IMG /bin/bash


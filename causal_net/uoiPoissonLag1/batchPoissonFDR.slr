#!/bin/bash 
#SBATCH  -N 4  -C cpu --exclusive -A m2043 
# SBATCH  --time=30:00 -q debug
#SBATCH --time 10:28:00  -q regular 
#SBATCH --output=out/%j.out
#SBATCH  --licenses=scratch
#SBATCH  --image nersc/causal-net:v5   # Nov 5 2025

# - - - E N D    O F    SLURM    C O M M A N D S
set -u ;  # exit  if you try to use an uninitialized variable

export OMP_NUM_THREADS=2

#dataName=daleM20_746c4b
#dataName=daleM40_e33e89
#dataName=daleM80_285c84
#dataName=daleM150_448b86

#  only Jan owns those 2 datasets:
#dataName=daleM300_aa61f5
#dataName=daleM130_6eb245  # hard case
dataName=daleM140_154782  # hard case
#dataName=daleM160_226532  # easy case

#samples=100_000 ; maxIter=50
#samples=300_000 ; maxIter=600
samples=1000_000 ; maxIter=500
#samples=3000_000 ; maxIter=100

N=${SLURM_NNODES}
jobId=${SLURM_JOBID}
ntask=$((32 * N))
echo S: job dataName=$dataName samples=$samples ntask=$ntask maxIter $maxIter 

time srun -n $ntask --distribution=block:block shifter python  fit_uoiPoissonLag1.py --dataName  $dataName --samples $samples --maxIter $maxIter  --dataPath /pscratch/sd/b/balewski/2025_causalNet_tmp/   --verb 2   --fdrRate 0.001

# spare --freqWeight

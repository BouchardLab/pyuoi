#!/bin/bash 
#SBATCH  -N 1  -C cpu --exclusive   -A m2043  # PI=Kris
#SBATCH  --image nersc/causal-net:v3
#SBATCH  --time=28:00 -q debug
# SBATCH --time 20:28:00  -q regular 
#SBATCH --output=out/%j.out
# - - - E N D    O F    SLURM    C O M M A N D S
set -u ;  # exit  if you try to use an uninitialized variable

  
nfeat=${1:-20}
tstart=${2:-10}

deltaT=60
# Use Python to compute tstop
tstop=$(python3 -c "print('%.1f'%($tstart + $deltaT))")
jobId=${SLURM_JOBID}

inpName=HET_80k_1_2ms1kHz ; fitName=A-t${tstart}+${deltaT}-$jobId


N=${SLURM_NNODES}
nrank=$N

echo S: job  $N=N  nrank=$nrank `hostname`

#export OMP_NUM_THREADS=2
env |grep OMP_

#..... input data
M2043=/global/cfs/cdirs/m2043/causal_inference

CFSH=/global/cfs/cdirs/mpccc/balewski
BASE_DIR=/2025_UoI-VAR   # here git has home
WORK_DIR=$BASE_DIR/causal_net/stable
DATA_VAULT=${CFSH}/bioDataVault2025/causalNet_tmp


#... output
jobId=${SLURM_JOBID}
outPath=$SCRATCH/jobs_causal_net/$jobId
echo outPath=$outPath
mkdir -p $outPath
cp -rp ../toolbox *py batchShifter.slr   $outPath/

cd $outPath


#( sleep 600; echo HOST `hostname` ; date; free -g; top ibn1)&
CMD=" ./fit_uoiVar.py --dataPath ${M2043}/DIV13/features_2ms  --inpName $inpName --basePath ${DATA_VAULT} --lag_depth 1  --minSpikeFreq 1.5  --time_range $tstart $tstop --num_feature $nfeat   --fitName $fitName "  

echo S:CMD=$CMD

srun -n $nrank  shifter  $CMD
echo S:done1 ; date


#Cancel all my jobs:
#  squeue -u $USER -h | awk '{print $1}' | xargs scancel
